# Configuración de Base de Datos PostgreSQL
DB_ENGINE=django.db.backends.postgresql
DB_NAME=mng_db
DB_USER=postgres
DB_PASSWORD=tu_contraseña_aqui
DB_HOST=localhost
DB_PORT=5432

# Opcional: Secret key y Debug para entorno local
SECRET_KEY=django-insecure-tu_secret_key_aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
